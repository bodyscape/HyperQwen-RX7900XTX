# HyperQwen on an AMD Radeon RX 7900 XTX (docs/rocm.md). Copy to .env and keep only what you change:
#   Copy-Item .env.rocm.example .env        (PowerShell)
#   docker compose up -d --force-recreate rocm
# Every value below is read at container start (env_file in docker-compose.yml), so changing it needs no rebuild.

# --- 150k context, one user (the measured long-context setup) -----------------------------------------------------
# 3-bit Octave KV cache on ROCM_OCTAVE (target and MTP drafter), 192 KV splits. Without it the bf16 cache holds ~75k.
HQ_ROCM_KV=octave
MAX_LEN=150000
MAX_SEQS=1

# Share of the 24 GiB the engine takes. 0.86 leaves ~1 GiB for the Windows desktop on the same card; at 0.90 long
# prefills filled the card, Windows paged GPU memory to RAM and the PC froze. Close other GPU programs (Ollama,
# whisper-server...) before starting: the engine refuses to boot when less than GPU_UTIL of the card is free.
GPU_UTIL=0.86
# Next to another GPU program, leave the engine ~18 GiB for the 150k window and keep ~1 GiB free. Measured with a
# whisper-server holding 2 GB: GPU_UTIL=0.75 boots with a 181k-token pool, decodes 98.9 tok/s on labd at 74k with an
# 80 s cold prefill, and nothing spills to RAM. With a 4 GB whisper the 150k window does not fit (0.67 refuses).
# GPU_UTIL=0.75

# MTP speculation with 3 drafts (the launcher's default here). SPEC=off disables it.
SPEC=mtp
DRAFT_TOKENS=3

# Port (18020 is inside a range Windows reserves on many machines).
PORT=19020

# Who can reach it. Default: this machine only (127.0.0.1). To serve other machines on the LAN, set the address of
# this machine's network card here; with no VLLM_API_KEY anyone who can reach that address can use the model, and
# can read /metrics and /tokenize. A DHCP address can change: reserve it in the router, or the port will not bind.
# BIND=<IP-LAN-de-cette-machine>
# VLLM_API_KEY=

# --- ROCm runtime ---------------------------------------------------------------------------------------------------
# The image rebuilds libhsa-runtime64 with the upstream fix for the idle CPU spin under WSL2 (rocm/rocr/): an idle
# server costs ~3% CPU instead of ~420%. HQ_ROCR_PATCH=0 uses the stock runtime.
# HQ_ROCR_PATCH=1

# --- RDNA3 kernels (rocm/w4a16_gemv.cu, in the image) -----------------------------------------------------------
# Decode GEMMs: 1-4 rows go to the single-read GEMV, 5-32 rows to the WMMA kernel (HQ_W4A16_WMMA=0 turns it off); HQ_W4A16_GEMV=0 falls back to vLLM's kernel.
# HQ_W4A16_GEMV=1
# Prefill chunks of at least this many rows are dequantized to bf16 and run through hipBLASLt (~10% faster GEMMs);
# 0 turns that off.
# HQ_W4A16_DQ_MIN_M=1024

# --- short-context alternative --------------------------------------------------------------------------------------
# For chat only, the bf16 cache is a little faster at short prompts and holds ~75k tokens:
# HQ_ROCM_KV=bf16
# MAX_LEN=8192
# MAX_SEQS=2
