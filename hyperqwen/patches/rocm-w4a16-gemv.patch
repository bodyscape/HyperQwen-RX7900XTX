         assert w_zp is not None, "Zero points are required by RDNA3 W4A16"
-        output = ops.gptq_gemm_rdna3(x_2d, w_q, w_zp, w_s, False)
+        output = torch.ops.vllm.hq_rdna3_w4a16_gemm(x_2d, w_q, w_zp, w_s)
 
         if bias is not None:
