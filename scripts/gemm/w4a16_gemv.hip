// !!! This is a file automatically generated by hipify!!!
// W4A16 GEMV for RDNA3 (gfx1100), M <= 8 activation rows, bf16, GPTQ/exllama-shuffled int4 weights.
//
// Same weight format as vllm's gptq_gemm_rdna3: qweight [K/8, N] uint32 (after gptq_shuffle: nibble pair i of a
// word holds K elements 2i and 2i+1 as the low and high 16-bit halves of (w >> 4i) & 0x000F000F), qzeros
// [K/128, N/8] uint32 (stored zero - 1, unless v2), scales [K/128, N] bf16.
//
// Why a new kernel: gptq_gemm_rdna3 reads the weights once per 4 activation rows, so a 5-row speculative verify
// reads them twice, and its inner loop spends ~2 FMAs per row and weight. Here every weight word is read once for
// up to 8 rows, and a whole 128-wide quantization group is accumulated as sum((128+nibble) * a) with v_dot2_f32_bf16
// before the scale and the zero-point correction are applied once per group.
//
// Mapping: a block is 8 waves; its 32 lanes x 4 columns = 128 output columns. The waves split K between them
// (whole groups) and are reduced through LDS. gridDim.y splits K further for narrow outputs; the partial sums are
// then added by a second tiny kernel (fixed order, so the result is deterministic).
#include <torch/extension.h>
#include <ATen/hip/HIPContext.h>
#include <c10/hip/HIPGuard.h>
#include <hip/hip_runtime.h>

#include <cstdint>

typedef short __attribute__((ext_vector_type(2))) bf16x2_t;
typedef unsigned int u32x4 __attribute__((ext_vector_type(4)));

// Tuning knobs, fixed at build time: waves per block, weight rows in flight per thread, non-temporal weight loads
// (the weights are streamed once per call, so they need not stay in the caches), and the target block count that
// sets the K split for narrow outputs.
#ifndef HQ_WAVES
#define HQ_WAVES 8
#endif
#ifndef HQ_RIF
#define HQ_RIF 8
#endif
// Non-temporal loads measured best of eight variants (sum of four layer shapes at M=4: 251.7 -> 243.2 us; M=1
// -6%, M=8 -8%); 16 rows in flight, 4 waves per block and a 512-block K-split target were equal or slower.
#ifndef HQ_NT
#define HQ_NT 1
#endif
#ifndef HQ_KSPLIT_TARGET
#define HQ_KSPLIT_TARGET 256
#endif

#ifndef HQ_MAX_M
#define HQ_MAX_M 16
#endif
constexpr int WAVES = HQ_WAVES;
constexpr int GS = 128;               // quantization group size (checked on the host)
constexpr int ROWS_PER_GROUP = GS / 8;  // 16 weight words per column and group
constexpr uint32_t MAGIC = 0x43004300u;  // bf16x2 (128, 128)
constexpr uint32_t ONES = 0x3F803F80u;   // bf16x2 (1, 1)

__device__ __forceinline__ float dot2(uint32_t a, uint32_t b, float c) {
  return __builtin_amdgcn_fdot2_f32_bf16(__builtin_bit_cast(bf16x2_t, a), __builtin_bit_cast(bf16x2_t, b), c, false);
}

__device__ __forceinline__ u32x4 load_w(const uint32_t* p) {
#if HQ_NT
  return __builtin_nontemporal_load((const u32x4*)p);
#else
  return *(const u32x4*)p;
#endif
}

__device__ __forceinline__ float bf2f(uint16_t v) { return __uint_as_float(((uint32_t)v) << 16); }

__device__ __forceinline__ uint16_t f2bf(float f) {
  uint32_t u = __float_as_uint(f);
  u += 0x7FFFu + ((u >> 16) & 1u);  // round to nearest even (no NaN handling needed here)
  return (uint16_t)(u >> 16);
}

template <int M>
__global__ void __launch_bounds__(WAVES * 32)
gemv_kernel(const uint16_t* __restrict__ A, const uint32_t* __restrict__ Wq, const uint32_t* __restrict__ Zq,
            const uint16_t* __restrict__ S, uint16_t* __restrict__ out, float* __restrict__ partial, int K, int N,
            int zero_off, int ksplit) {
  __shared__ float red[WAVES][(M < 8 ? M : 8)][128];
  const int lane = threadIdx.x & 31;
  // The wave index is uniform; telling the compiler lets the activation reads (same address in all lanes) become
  // scalar loads instead of M redundant vector loads per weight word.
  const int wave = __builtin_amdgcn_readfirstlane(threadIdx.x >> 5);
  const int n0 = (blockIdx.x * 32 + lane) * 4;
  const int groups = K / GS;
  const int slice = blockIdx.y * WAVES + wave;
  const int total = ksplit * WAVES;
  const int g0 = (int)((long long)groups * slice / total);
  const int g1 = (int)((long long)groups * (slice + 1) / total);

  float acc[M][4];
#pragma unroll
  for (int m = 0; m < M; ++m)
#pragma unroll
    for (int c = 0; c < 4; ++c) acc[m][c] = 0.f;

  if (n0 < N) {
    for (int g = g0; g < g1; ++g) {
      const uint2 s2 = *(const uint2*)(S + (size_t)g * N + n0);
      float sc[4] = {bf2f((uint16_t)(s2.x & 0xFFFF)), bf2f((uint16_t)(s2.x >> 16)), bf2f((uint16_t)(s2.y & 0xFFFF)),
                     bf2f((uint16_t)(s2.y >> 16))};
      const uint32_t zw = Zq[(size_t)g * (N / 8) + (n0 >> 3)] >> ((n0 & 7) * 4);
      float zf[4];
#pragma unroll
      for (int c = 0; c < 4; ++c) zf[c] = (float)(128 + ((zw >> (4 * c)) & 0xF) + zero_off);

      float part[M][4];
      float suma[M];
#pragma unroll
      for (int m = 0; m < M; ++m) {
        suma[m] = 0.f;
#pragma unroll
        for (int c = 0; c < 4; ++c) part[m][c] = 0.f;
      }
      const uint32_t* wp = Wq + (size_t)(g * ROWS_PER_GROUP) * N + n0;
#pragma unroll
      for (int h0 = 0; h0 < ROWS_PER_GROUP; h0 += HQ_RIF) {
        u32x4 w[HQ_RIF];
#pragma unroll
        for (int j = 0; j < HQ_RIF; ++j) w[j] = load_w(wp + (size_t)(h0 + j) * N);
#pragma unroll
        for (int j = 0; j < HQ_RIF; ++j) {
          const int k0 = (g * ROWS_PER_GROUP + h0 + j) * 8;
          const uint32_t wc[4] = {w[j].x, w[j].y, w[j].z, w[j].w};
          uint32_t q[4][4];
#pragma unroll
          for (int c = 0; c < 4; ++c)
#pragma unroll
            for (int i = 0; i < 4; ++i) q[c][i] = ((wc[c] >> (4 * i)) & 0x000F000Fu) | MAGIC;
#pragma unroll
          for (int m = 0; m < M; ++m) {
            const uint4 av = *(const uint4*)(A + (size_t)m * K + k0);
            const uint32_t aw[4] = {av.x, av.y, av.z, av.w};
            float sa = suma[m];
#pragma unroll
            for (int i = 0; i < 4; ++i) sa = dot2(aw[i], ONES, sa);
            suma[m] = sa;
#pragma unroll
            for (int c = 0; c < 4; ++c) {
              float p = part[m][c];
#pragma unroll
              for (int i = 0; i < 4; ++i) p = dot2(aw[i], q[c][i], p);
              part[m][c] = p;
            }
          }
        }
      }
#pragma unroll
      for (int m = 0; m < M; ++m)
#pragma unroll
        for (int c = 0; c < 4; ++c) acc[m][c] = __fmaf_rn(sc[c], __fmaf_rn(-zf[c], suma[m], part[m][c]), acc[m][c]);
    }
  }

  // Cross-wave reduction through LDS, at most 8 activation rows at a time (M up to 16 would need 64 KB at once).
#pragma unroll
  for (int mb = 0; mb < M; mb += 8) {
    constexpr int MB = 8;
#pragma unroll
    for (int m = 0; m < MB; ++m)
      if (mb + m < M)
#pragma unroll
        for (int c = 0; c < 4; ++c) red[wave][m][lane * 4 + c] = acc[mb + m][c];
    __syncthreads();
    for (int idx = threadIdx.x; idx < MB * 128; idx += WAVES * 32) {
      const int m = mb + (idx >> 7), cl = idx & 127;
      if (m >= M) continue;
      float s = 0.f;
#pragma unroll
      for (int w = 0; w < WAVES; ++w) s += red[w][m - mb][cl];
      const int n = blockIdx.x * 128 + cl;
      if (n < N) {
        if (ksplit == 1)
          out[(size_t)m * N + n] = f2bf(s);
        else
          partial[((size_t)blockIdx.y * M + m) * N + n] = s;
      }
    }
    __syncthreads();
  }
}

__global__ void reduce_kernel(const float* __restrict__ partial, uint16_t* __restrict__ out, int M, int N,
                              int ksplit) {
  const int idx = blockIdx.x * blockDim.x + threadIdx.x;
  if (idx >= M * N) return;
  float s = 0.f;
  for (int k = 0; k < ksplit; ++k) s += partial[(size_t)k * M * N + idx];
  out[idx] = f2bf(s);
}

template <int M>
static void launch(const torch::Tensor& a, const torch::Tensor& qw, const torch::Tensor& qz, const torch::Tensor& sc,
                   torch::Tensor& out, int K, int N, int zero_off, int ksplit, hipStream_t stream) {
  const int tiles = (N + 127) / 128;
  torch::Tensor partial;
  float* pp = nullptr;
  if (ksplit > 1) {
    partial = torch::empty({ksplit, M, N}, a.options().dtype(torch::kFloat32));
    pp = partial.data_ptr<float>();
  }
  dim3 grid(tiles, ksplit);
 hipLaunchKernelGGL(( gemv_kernel<M>), dim3(grid), dim3(WAVES * 32), 0, stream, (const uint16_t*)a.data_ptr(), (const uint32_t*)qw.data_ptr(),
                                                   (const uint32_t*)qz.data_ptr(), (const uint16_t*)sc.data_ptr(),
                                                   (uint16_t*)out.data_ptr(), pp, K, N, zero_off, ksplit);
  if (ksplit > 1) {
    const int n = M * N;
   hipLaunchKernelGGL(( reduce_kernel), dim3((n + 255) / 256), dim3(256), 0, stream, pp, (uint16_t*)out.data_ptr(), M, N, ksplit);
  }
}

torch::Tensor w4a16_gemv(torch::Tensor a, torch::Tensor qweight, torch::Tensor qzeros, torch::Tensor scales,
                         bool use_v2_format, int64_t ksplit_override) {
  TORCH_CHECK(a.is_cuda() && a.scalar_type() == at::kBFloat16 && a.is_contiguous(), "a must be contiguous bf16");
  TORCH_CHECK(scales.scalar_type() == at::kBFloat16 && scales.is_contiguous(), "scales must be bf16");
  TORCH_CHECK(qweight.scalar_type() == at::kInt && qzeros.scalar_type() == at::kInt, "qweight/qzeros must be int32");
  const int M = a.size(0), K = a.size(1), N = qweight.size(1);
  TORCH_CHECK(M >= 1 && M <= HQ_MAX_M, "M must be 1..HQ_MAX_M");
  TORCH_CHECK(qweight.size(0) * 8 == K, "K mismatch");
  TORCH_CHECK(K % GS == 0 && scales.size(0) * GS == K, "group size must be 128");
  TORCH_CHECK(N % 8 == 0, "N must be a multiple of 8");
  const at::cuda::OptionalCUDAGuard guard(device_of(a));
  auto stream = at::cuda::getCurrentCUDAStream().stream();
  auto out = torch::empty({M, N}, a.options());
  const int groups = K / GS;
  const int tiles = (N + 127) / 128;
  int ksplit = ksplit_override > 0 ? (int)ksplit_override : (HQ_KSPLIT_TARGET + tiles - 1) / tiles;
  ksplit = ::max(1, ::min(ksplit, ::max(1, groups / WAVES)));
  const int zero_off = use_v2_format ? 0 : 1;
  switch (M) {
    case 1: launch<1>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 2: launch<2>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 3: launch<3>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 4: launch<4>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 5: launch<5>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 6: launch<6>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 7: launch<7>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 8: launch<8>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
#if HQ_MAX_M > 8
    case 9: launch<9>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 10: launch<10>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 11: launch<11>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 12: launch<12>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 13: launch<13>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 14: launch<14>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    case 15: launch<15>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
    default: launch<16>(a, qweight, qzeros, scales, out, K, N, zero_off, ksplit, stream); break;
#endif
  }
  return out;
}

// Dequantize the whole matrix to bf16 [K, N] (row-major), for large batches (prefill): there the GEMM is
// compute-bound and hipBLASLt's bf16 GEMM beats gptq_gemm_rdna3 by 10-30% (measured at M = 1024-2048), while the
// dequantization costs one read of the int4 weights and one write of the bf16 copy. One thread per weight word:
// 8 consecutive K rows of one column; consecutive threads take consecutive columns, so reads and writes coalesce.
__global__ void dequant_kernel(const uint32_t* __restrict__ Wq, const uint32_t* __restrict__ Zq,
                               const uint16_t* __restrict__ S, uint16_t* __restrict__ out, int K, int N,
                               int zero_off) {
  const int n = blockIdx.x * blockDim.x + threadIdx.x;
  const int kr = blockIdx.y;
  if (n >= N) return;
  const uint32_t w = Wq[(size_t)kr * N + n];
  const int g = (kr * 8) / GS;
  const float s = bf2f(S[(size_t)g * N + n]);
  const float z = (float)(((Zq[(size_t)g * (N / 8) + (n >> 3)] >> ((n & 7) * 4)) & 0xF) + zero_off);
  uint16_t* o = out + (size_t)(kr * 8) * N + n;
#pragma unroll
  for (int i = 0; i < 4; ++i) {
    o[(size_t)(2 * i) * N] = f2bf(s * ((float)((w >> (4 * i)) & 0xF) - z));
    o[(size_t)(2 * i + 1) * N] = f2bf(s * ((float)((w >> (4 * i + 16)) & 0xF) - z));
  }
}

torch::Tensor w4a16_dequant(torch::Tensor qweight, torch::Tensor qzeros, torch::Tensor scales, bool use_v2_format) {
  TORCH_CHECK(qweight.is_cuda() && qweight.scalar_type() == at::kInt && qweight.is_contiguous(), "qweight: int32");
  TORCH_CHECK(qzeros.scalar_type() == at::kInt && qzeros.is_contiguous(), "qzeros: int32");
  TORCH_CHECK(scales.scalar_type() == at::kBFloat16 && scales.is_contiguous(), "scales must be bf16");
  const int K = qweight.size(0) * 8, N = qweight.size(1);
  TORCH_CHECK(K % GS == 0 && scales.size(0) * GS == K && N % 8 == 0, "group size 128, N % 8 == 0");
  const at::cuda::OptionalCUDAGuard guard(device_of(qweight));
  auto stream = at::cuda::getCurrentCUDAStream().stream();
  auto out = torch::empty({K, N}, scales.options());
  dim3 grid((N + 255) / 256, K / 8);
 hipLaunchKernelGGL(( dequant_kernel), dim3(grid), dim3(256), 0, stream, (const uint32_t*)qweight.data_ptr(), (const uint32_t*)qzeros.data_ptr(),
                                           (const uint16_t*)scales.data_ptr(), (uint16_t*)out.data_ptr(), K, N,
                                           use_v2_format ? 0 : 1);
  return out;
}

// ---------------------------------------------------------------------------------------------------------------
// WMMA variant for 9..32 activation rows (3-8 concurrent speculative requests: 4 rows each).
//
// Why: above 8 rows the dot2 GEMV is compute-bound and the stock kernels fall to ~340 GB/s (M = 12..16) and
// ~170-200 GB/s (M = 17..32, weights read twice). Here the weights are read once, through the matrix units:
// B fragments are built straight from the int4 words ((nibble | 0x4300) is the bf16 number 128 + nibble, exact), a
// second WMMA against an all-ones B gives each row's sum of activations, and the zero point and the scale are applied
// per 128-wide group in fp32, exactly as in the GEMV: out = s * (sum a * (128 + w) - (128 + z) * sum a).
//
// Mapping: a wave owns 64 output columns, 4 per lane-column of the 16x16 tile: WMMA j uses column 4 * c + j for tile
// column c, so one uint4 load per weight row gives a lane the words of its 4 columns (256 B contiguous per row for
// the 16 lanes of a half wave; lanes c and c + 16 load the same words, as the A/B operands are replicated in both half
// waves). Waves of a block split K by whole groups; the partial tiles are reduced through LDS, and gridDim.y splits K
// further for narrow outputs (second kernel adds the partials in a fixed order).
typedef short __attribute__((ext_vector_type(16))) bf16x16_t;
typedef float __attribute__((ext_vector_type(8))) f32x8_t;
typedef unsigned int __attribute__((ext_vector_type(8))) u32x8_t;

#ifndef HQ_W2_WAVES
#define HQ_W2_WAVES 8
#endif
#ifndef HQ_W2_UN
#define HQ_W2_UN 4          // 16-wide K steps in flight per group pass (8 per group)
#endif
constexpr int W2 = HQ_W2_WAVES;

__device__ __forceinline__ f32x8_t wmma_bf16(const u32x8_t& a, const u32x8_t& b, const f32x8_t& c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(__builtin_bit_cast(bf16x16_t, a), __builtin_bit_cast(bf16x16_t, b),
                                                      c);
}

template <int T>
__global__ void __launch_bounds__(W2 * 32)
wmma_kernel(const uint16_t* __restrict__ A, const uint32_t* __restrict__ Wq, const uint32_t* __restrict__ Zq,
            const uint16_t* __restrict__ S, uint16_t* __restrict__ out, float* __restrict__ partial, int M, int K,
            int N, int zero_off, int ksplit) {
  __shared__ float red[W2][16][64];
  const int lane = threadIdx.x & 31;
  const int wave = __builtin_amdgcn_readfirstlane(threadIdx.x >> 5);
  const int lm = lane & 15, half = lane >> 4;
  const int n0 = (blockIdx.x * 16 + lm) * 4;
  const int groups = K / GS;
  const int slice = blockIdx.y * W2 + wave;
  const int total = ksplit * W2;
  const int g0 = (int)((long long)groups * slice / total);
  const int g1 = (int)((long long)groups * (slice + 1) / total);

  f32x8_t acc[T][4];
#pragma unroll
  for (int t = 0; t < T; ++t)
#pragma unroll
    for (int j = 0; j < 4; ++j)
#pragma unroll
      for (int i = 0; i < 8; ++i) acc[t][j][i] = 0.f;

  u32x8_t ones;
#pragma unroll
  for (int i = 0; i < 8; ++i) ones[i] = ONES;
  const uint32_t* arow[T];
  bool rvalid[T];
#pragma unroll
  for (int t = 0; t < T; ++t) {
    rvalid[t] = (t * 16 + lm) < M;
    arow[t] = (const uint32_t*)(A + (size_t)(rvalid[t] ? (t * 16 + lm) : 0) * K);
  }

  if (n0 < N) {
    for (int g = g0; g < g1; ++g) {
      const uint2 s2 = *(const uint2*)(S + (size_t)g * N + n0);
      const float sc[4] = {bf2f((uint16_t)(s2.x & 0xFFFF)), bf2f((uint16_t)(s2.x >> 16)),
                           bf2f((uint16_t)(s2.y & 0xFFFF)), bf2f((uint16_t)(s2.y >> 16))};
      const uint32_t zw = Zq[(size_t)g * (N / 8) + (n0 >> 3)] >> ((n0 & 7) * 4);
      float zf[4];
#pragma unroll
      for (int c = 0; c < 4; ++c) zf[c] = (float)(128 + ((zw >> (4 * c)) & 0xF) + zero_off);

      f32x8_t d[T][4], ds[T];
#pragma unroll
      for (int t = 0; t < T; ++t) {
#pragma unroll
        for (int i = 0; i < 8; ++i) ds[t][i] = 0.f;
#pragma unroll
        for (int j = 0; j < 4; ++j)
#pragma unroll
          for (int i = 0; i < 8; ++i) d[t][j][i] = 0.f;
      }
      const uint32_t* wp = Wq + (size_t)(g * ROWS_PER_GROUP) * N + n0;
#pragma unroll
      for (int kb = 0; kb < 8; kb += HQ_W2_UN) {
        u32x4 w0[HQ_W2_UN], w1[HQ_W2_UN];
#pragma unroll
        for (int u = 0; u < HQ_W2_UN; ++u) {
          w0[u] = load_w(wp + (size_t)(2 * (kb + u)) * N);
          w1[u] = load_w(wp + (size_t)(2 * (kb + u) + 1) * N);
        }
#pragma unroll
        for (int u = 0; u < HQ_W2_UN; ++u) {
          const int k0 = (g * 8 + kb + u) * 16;
          u32x8_t av[T];
#pragma unroll
          for (int t = 0; t < T; ++t) {
            const uint4 lo = *(const uint4*)(arow[t] + (k0 >> 1));
            const uint4 hi = *(const uint4*)(arow[t] + (k0 >> 1) + 4);
            const bool v = rvalid[t];
            av[t] = u32x8_t{v ? lo.x : 0u, v ? lo.y : 0u, v ? lo.z : 0u, v ? lo.w : 0u,
                            v ? hi.x : 0u, v ? hi.y : 0u, v ? hi.z : 0u, v ? hi.w : 0u};
          }
          const uint32_t wa[4] = {w0[u].x, w0[u].y, w0[u].z, w0[u].w};
          const uint32_t wb[4] = {w1[u].x, w1[u].y, w1[u].z, w1[u].w};
#pragma unroll
          for (int j = 0; j < 4; ++j) {
            u32x8_t b;
#pragma unroll
            for (int i = 0; i < 4; ++i) {
              b[i] = ((wa[j] >> (4 * i)) & 0x000F000Fu) | MAGIC;
              b[4 + i] = ((wb[j] >> (4 * i)) & 0x000F000Fu) | MAGIC;
            }
#pragma unroll
            for (int t = 0; t < T; ++t) d[t][j] = wmma_bf16(av[t], b, d[t][j]);
          }
#pragma unroll
          for (int t = 0; t < T; ++t) ds[t] = wmma_bf16(av[t], ones, ds[t]);
        }
      }
#pragma unroll
      for (int t = 0; t < T; ++t)
#pragma unroll
        for (int j = 0; j < 4; ++j)
#pragma unroll
          for (int i = 0; i < 8; ++i)
            acc[t][j][i] = __fmaf_rn(sc[j], __fmaf_rn(-zf[j], ds[t][i], d[t][j][i]), acc[t][j][i]);
    }
  }

#pragma unroll
  for (int t = 0; t < T; ++t) {
#pragma unroll
    for (int j = 0; j < 4; ++j)
#pragma unroll
      for (int i = 0; i < 8; ++i) red[wave][2 * i + half][lm * 4 + j] = acc[t][j][i];
    __syncthreads();
    for (int idx = threadIdx.x; idx < 16 * 64; idx += W2 * 32) {
      const int r = idx >> 6, cl = idx & 63;
      const int m = t * 16 + r;
      const int n = blockIdx.x * 64 + cl;
      if (m < M && n < N) {
        float s = 0.f;
#pragma unroll
        for (int w = 0; w < W2; ++w) s += red[w][r][cl];
        if (ksplit == 1)
          out[(size_t)m * N + n] = f2bf(s);
        else
          partial[((size_t)blockIdx.y * M + m) * N + n] = s;
      }
    }
    __syncthreads();
  }
}

template <int T>
static void launch_wmma(const torch::Tensor& a, const torch::Tensor& qw, const torch::Tensor& qz,
                        const torch::Tensor& sc, torch::Tensor& out, int M, int K, int N, int zero_off, int ksplit,
                        hipStream_t stream) {
  const int tiles = (N + 63) / 64;
  torch::Tensor partial;
  float* pp = nullptr;
  if (ksplit > 1) {
    partial = torch::empty({ksplit, M, N}, a.options().dtype(torch::kFloat32));
    pp = partial.data_ptr<float>();
  }
  dim3 grid(tiles, ksplit);
 hipLaunchKernelGGL(( wmma_kernel<T>), dim3(grid), dim3(W2 * 32), 0, stream, (const uint16_t*)a.data_ptr(), (const uint32_t*)qw.data_ptr(),
                                                (const uint32_t*)qz.data_ptr(), (const uint16_t*)sc.data_ptr(),
                                                (uint16_t*)out.data_ptr(), pp, M, K, N, zero_off, ksplit);
  if (ksplit > 1) {
    const int n = M * N;
   hipLaunchKernelGGL(( reduce_kernel), dim3((n + 255) / 256), dim3(256), 0, stream, pp, (uint16_t*)out.data_ptr(), M, N, ksplit);
  }
}

torch::Tensor w4a16_wmma(torch::Tensor a, torch::Tensor qweight, torch::Tensor qzeros, torch::Tensor scales,
                         bool use_v2_format, int64_t ksplit_override) {
  TORCH_CHECK(a.is_cuda() && a.scalar_type() == at::kBFloat16 && a.is_contiguous(), "a must be contiguous bf16");
  TORCH_CHECK(scales.scalar_type() == at::kBFloat16 && scales.is_contiguous(), "scales must be bf16");
  TORCH_CHECK(qweight.scalar_type() == at::kInt && qzeros.scalar_type() == at::kInt, "qweight/qzeros must be int32");
  const int M = a.size(0), K = a.size(1), N = qweight.size(1);
  TORCH_CHECK(M >= 1 && M <= 32, "M must be 1..32");
  TORCH_CHECK(qweight.size(0) * 8 == K, "K mismatch");
  TORCH_CHECK(K % GS == 0 && scales.size(0) * GS == K, "group size must be 128");
  TORCH_CHECK(N % 8 == 0, "N must be a multiple of 8");
  const at::cuda::OptionalCUDAGuard guard(device_of(a));
  auto stream = at::cuda::getCurrentCUDAStream().stream();
  auto out = torch::empty({M, N}, a.options());
  const int groups = K / GS;
  const int tiles = (N + 63) / 64;
  int ksplit = ksplit_override > 0 ? (int)ksplit_override : (HQ_KSPLIT_TARGET + tiles - 1) / tiles;
  ksplit = ::max(1, ::min(ksplit, ::max(1, groups / W2)));
  const int zero_off = use_v2_format ? 0 : 1;
  if (M <= 16)
    launch_wmma<1>(a, qweight, qzeros, scales, out, M, K, N, zero_off, ksplit, stream);
  else
    launch_wmma<2>(a, qweight, qzeros, scales, out, M, K, N, zero_off, ksplit, stream);
  return out;
}

// Registered ops, not pybind functions: vLLM calls them from torch.compile'd code and from captured HIP graphs.
TORCH_LIBRARY_FRAGMENT(hq, m) {
  m.def("w4a16_gemv(Tensor a, Tensor qweight, Tensor qzeros, Tensor scales, bool use_v2_format, int ksplit) -> Tensor");
  m.def("w4a16_wmma(Tensor a, Tensor qweight, Tensor qzeros, Tensor scales, bool use_v2_format, int ksplit) -> Tensor");
  m.def("w4a16_dequant(Tensor qweight, Tensor qzeros, Tensor scales, bool use_v2_format) -> Tensor");
}
TORCH_LIBRARY_IMPL(hq, CUDA, m) {
  m.impl("w4a16_gemv", &w4a16_gemv);
  m.impl("w4a16_wmma", &w4a16_wmma);
  m.impl("w4a16_dequant", &w4a16_dequant);
}
